{
	"name": "fanfou-sdk",
	"version": "7.0.0-beta.2",
	"description": "Fanfou SDK for Node.js",
	"license": "MIT",
	"repository": "github:fanfoujs/fanfou-sdk-node",
	"homepage": "https://github.com/fanfoujs/fanfou-sdk-node#readme",
	"bugs": "https://github.com/fanfoujs/fanfou-sdk-node/issues",
	"author": "LitoMore",
	"type": "module",
	"exports": {
		"types": "./distribution/source/index.d.ts",
		"default": "./distribution/source/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "del-cli distribution && tsc",
		"pretest": "npm run build",
		"test": "xo && c8 ava",
		"typedoc": "npm run build && del-cli docs && typedoc --gitRevision main source/index.ts",
		"deploy:doc": "gh-pages -d docs"
	},
	"files": [
		"distribution/source"
	],
	"keywords": [
		"fanfou"
	],
	"dependencies": {
		"camelcase-keys": "^10.0.3",
		"decamelize-keys": "^2.1.0",
		"form-data": "^4.0.6",
		"he": "^1.2.0",
		"hmacsha1": "^1.0.0",
		"ky": "^2.1.0",
		"oauth-1.0a": "^2.2.6",
		"query-string": "^9.5.1"
	},
	"devDependencies": {
		"@ava/typescript": "^7.0.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/express": "^5.0.6",
		"@types/he": "^1.2.3",
		"@types/node": "^26.6.2",
		"@types/test-listen": "^1.1.2",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"del-cli": "^7.0.0",
		"express": "^5.2.1",
		"gh-pages": "^6.3.0",
		"test-listen": "^1.1.0",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.20",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-7": "npm:typescript@^7.0.2",
		"xo": "^5.0.1"
	}
}
